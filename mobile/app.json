{
  "expo": {
    "name": "PaisaPay",
    "slug": "paisapay",
    "scheme": "paisapay",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/paisapay-customer-brand.png",
      "imageWidth": 220,
      "resizeMode": "contain",
      "backgroundColor": "#080F1F"
    },
    "android": {
      "package": "com.paisapay.app",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/paisapay-customer-emblem.png",
        "backgroundColor": "#080F1F"
      }
    },
    "plugins": [
      "expo-secure-store",
      "expo-notifications"
    ],
    "icon": "./assets/paisapay-customer-emblem.png"
  }
}
