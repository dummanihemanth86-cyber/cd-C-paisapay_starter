NODE_ENV=development
PORT=4000
HOST=0.0.0.0
APP_ORIGIN=http://localhost:5173
DEPOSIT_RECEIVER_UPI_ID=zitch@ptyes
MIN_DEPOSIT_PAISE=1000
MAX_DEPOSIT_PAISE=1000000
P2P_WITHDRAWAL_OFFER_TTL_MINUTES=30
UPI_DEPOSIT_REWARD_PERCENT_BPS=1700
UPI_DEPOSIT_REWARD_ENABLED=false
UPI_DEPOSIT_REWARD_FUNDING_SOURCE=
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
SESSION_HASH_SECRET=GENERATE_A_LONG_RANDOM_SECRET
BANK_ACCOUNT_ENCRYPTION_KEY=GENERATE_A_32_BYTE_KEY
# Keep disabled until a rotated Renflair V1 key is configured below; then use renflair-v1.
OTP_PROVIDER=disabled
OTP_API_KEY=
# Optional local testing exception for one E.164 phone; leave blank normally. IP rate limits still apply.
OTP_RATE_LIMIT_BYPASS_PHONE=
SMS_GATEWAY_URL=
SMS_GATEWAY_API_KEY=
SMS_GATEWAY_TIMEOUT_MS=5000
# Renflair V1: API key is sent as a URL query parameter by the supplied API.
# Keep it server-side, rotate any key previously pasted into chat, and do not
# enable until a new key is configured.
RENFLAIR_V1_API_URL=https://sms.renflair.in/V1.php
RENFLAIR_API_KEY=SET_IN_RENDER_DASHBOARD
# Optional Cashfree sandbox checkout. Leave disabled until the merchant account
# and the exact PaisaPay checkout use case are approved by Cashfree.
PAYMENT_PROVIDER=disabled
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_API_VERSION=2026-01-01
PAYMENT_MERCHANT_ID=
PAYMENT_SECRET=
PAYMENT_WEBHOOK_SECRET=
# Local development only: seeds a non-redeemable test pool, not real money.
WELCOME_BONUS_ENABLED=false
WELCOME_BONUS_AMOUNT_PAISE=9900
WELCOME_BONUS_FUNDING_SOURCE=
WELCOME_BONUS_TEST_FUND_PAISE=0
ADMIN_BOOTSTRAP_SECRET=

# Optional: Expo Push Service access token for authenticated push sends
EXPO_PUSH_ACCESS_TOKEN=

# Optional direct Neon PostgreSQL URL reserved for schema migrations. Runtime uses DATABASE_URL.
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
