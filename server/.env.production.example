# Template only. Add real values in Render's private Environment settings.
# Never commit a populated production .env file.
NODE_ENV=production
PAISAPAY_DEPLOYMENT_ENV=production
HOST=0.0.0.0
PORT=10000
# Leave blank for native-only clients. If a browser admin is deployed, set its
# exact HTTPS origin(s), comma-separated, without trailing slash or path.
APP_ORIGIN=
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
SESSION_HASH_SECRET=GENERATE_A_LONG_RANDOM_SECRET
BANK_ACCOUNT_ENCRYPTION_KEY=GENERATE_A_32_BYTE_KEY
OTP_PROVIDER=renflair-v1
RENFLAIR_API_KEY=
RENFLAIR_V1_API_URL=https://sms.renflair.in/V1.php
PAYMENT_PROVIDER=disabled
# Production is intentionally rejected if this is changed to true in this build.
FINANCIAL_OPERATIONS_ENABLED=false
# Enable only after manual recipient, reconciliation, and Finance review controls are verified.
MANUAL_UPI_OPERATIONS_ENABLED=false
MANUAL_UPI_PRODUCTION_APPROVED=false
# Keep disabled until the dedicated Admin wallet release is approved.
WALLET_ADJUSTMENTS_ENABLED=false
# Keep Admin funding and credits disabled until funding, reconciliation, and independent controls are verified.
ADMIN_WALLET_FUNDING_ENABLED=false
ADMIN_WALLET_CREDITS_ENABLED=false
# Explicit production authorization. Set true only in the approved release with all three Admin wallet gates true.
ADMIN_WALLET_PRODUCTION_APPROVED=false
ADMIN_WALLET_EXTERNAL_RECONCILIATION_VERIFIED=false
# Internal UUID of the one existing ADMIN account; leave blank while disabled.
WALLET_ADJUSTMENT_ADMIN_USER_ID=
# Set only after independently verifying the merchant account and reconciliation process.
# If unset, UPI deposit creation fails closed with HTTP 503.
DEPOSIT_RECEIVER_UPI_ID=
UPI_DEPOSIT_REWARD_ENABLED=false
WELCOME_BONUS_ENABLED=false
EXPO_PUSH_ACCESS_TOKEN=
