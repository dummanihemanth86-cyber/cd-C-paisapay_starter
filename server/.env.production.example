# Template only. Add real values in Render's private Environment settings.
# Never commit a populated production .env file.
NODE_ENV=production
HOST=0.0.0.0
PORT=10000
# Leave blank for native-only clients. If a browser admin is deployed, set its
# exact HTTPS origin(s), comma-separated, without trailing slash or path.
APP_ORIGIN=
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
SESSION_HASH_SECRET=GENERATE_A_LONG_RANDOM_SECRET
BANK_ACCOUNT_ENCRYPTION_KEY=GENERATE_A_32_BYTE_KEY
OTP_PROVIDER=renflair-v1
RENFLAIR_API_KEY=SET_IN_RENDER_DASHBOARD
RENFLAIR_V1_API_URL=https://sms.renflair.in/V1.php
PAYMENT_PROVIDER=disabled
UPI_DEPOSIT_REWARD_ENABLED=false
WELCOME_BONUS_ENABLED=false
EXPO_PUSH_ACCESS_TOKEN=
