{
  "expo": {
    "name": "PaisaPay Admin",
    "slug": "paisapay-admin",
    "scheme": "paisapay-admin",
    "version": "1.0.3",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "web": { "bundler": "metro", "output": "single" },
    "experiments": { "baseUrl": "/cd-C-paisapay_starter" },
    "icon": "./assets/paisapay-admin-emblem.png",
    "splash": {
      "image": "./assets/paisapay-admin-brand.png",
      "resizeMode": "contain",
      "backgroundColor": "#07101F"
    },
    "android": {
      "package": "com.paisapay.admin",
      "versionCode": 4,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/paisapay-admin-emblem.png",
        "backgroundColor": "#07101F"
      }
    },
    "plugins": ["./plugins/withAdminReleaseSigning", "expo-secure-store", "expo-notifications"]
  }
}
