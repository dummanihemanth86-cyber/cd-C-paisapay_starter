{
  "expo": {
    "name": "PaisaPay Admin",
    "slug": "paisapay-admin",
    "scheme": "paisapay-admin",
    "version": "1.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/paisapay-admin-icon.png",
    "splash": {
      "image": "./assets/paisapay-admin-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "android": {
      "package": "com.paisapay.admin",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/paisapay-admin-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "plugins": ["./plugins/withAdminReleaseSigning", "expo-secure-store", "expo-notifications"]
  }
}
