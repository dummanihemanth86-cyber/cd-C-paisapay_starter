{
  "name": "paisapay-admin-android",
  "version": "1.0.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start --dev-client --lan",
    "start:go": "expo start --go --lan",
    "start:dev-client": "expo start --dev-client --lan",
    "android": "expo run:android",
    "android:deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File ../../scripts/admin-android-deploy.ps1",
    "android:watch": "powershell -NoProfile -ExecutionPolicy Bypass -File ../../scripts/admin-android-watch.ps1",
    "prebuild:android": "expo prebuild --platform android",
    "build:android:debug": "cd android && gradlew.bat assembleDebug",
    "build:android:staging": "set EXPO_PUBLIC_API_URL=https://paisapay-api-staging.onrender.com&& cd android && gradlew.bat assembleRelease",
    "build:android:release": "set EXPO_PUBLIC_API_URL=https://paisapay-api.onrender.com&& cd android && gradlew.bat assembleRelease",
    "ios": "expo run:ios",
    "test": "node --test"
  },
  "dependencies": {
    "expo": "~54.0.0",
    "expo-clipboard": "~8.0.8",
    "expo-dev-client": "~6.0.21",
    "expo-notifications": "~0.32.17",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.8",
    "expo-system-ui": "~6.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-web": "~0.21.0"
  }
}
