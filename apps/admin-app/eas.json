{
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": { "buildType": "apk" }
    },
    "preview": {
      "environment": "preview",
      "distribution": "internal",
      "android": { "buildType": "apk" }
    },
    "staging-apk": {
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://paisapay-api-staging.onrender.com",
        "EXPO_PUBLIC_ADMIN_DEPLOYMENT_ENV": "staging"
      },
      "distribution": "internal",
      "android": { "buildType": "apk" }
    },
    "production-apk": {
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://paisapay-api.onrender.com",
        "EXPO_PUBLIC_ADMIN_DEPLOYMENT_ENV": "production"
      },
      "distribution": "internal",
      "autoIncrement": true,
      "android": { "buildType": "apk" }
    },
    "production": {
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://paisapay-api.onrender.com",
        "EXPO_PUBLIC_ADMIN_DEPLOYMENT_ENV": "production"
      },
      "autoIncrement": true,
      "android": { "buildType": "app-bundle" }
    }
  }
}
